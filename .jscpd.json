{
  "format": "markup,javascript,css,python,django",
  "formats-exts": {
    "django": "html"
  },
  "minTokens": 70,
  "threshold": 5,
  "gitignore": true,
  "ignore": [
    "**/migrations/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/static/vendors/**",
    "**/staticfiles/**",
    "**/locale/**",
    "**/docs/**",
    "**/declaration/**",
    "**/*.lock",
    "**/package-lock.json"
  ]
}
